{
  "name": "mtrl",
  "version": "0.8.0-next.35",
  "description": "A functional TypeScript/JavaScript component library with composable architecture based on Material Design 3",
  "author": "floor",
  "license": "MIT License",
  "keywords": [
    "component",
    "library",
    "ui",
    "user interface",
    "typescript",
    "functional",
    "composable",
    "material design 3",
    "md3",
    "testing",
    "jsdom",
    "tested",
    "type-safe"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "**/styles/*.js"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": "./dist/styles.css",
    "./components/*/constants": {
      "types": "./dist/components/*/constants.d.ts",
      "import": "./dist/components/*/constants.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./core/*": {
      "types": "./dist/core/*/index.d.ts",
      "import": "./dist/core/*/index.js"
    },
    "./styles/*": {
      "types": "./dist/styles/*.d.ts",
      "import": "./dist/styles/*.js"
    },
    "./themes/*": "./dist/themes/*.css"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "start": "bun run server.js",
    "dev": "bun --watch server.js",
    "build": "bun run build.ts",
    "prepublishOnly": "bun run build",
    "lint": "bunx eslint src --ext .ts,.tsx",
    "lint:fix": "bunx eslint src --ext .ts,.tsx --fix",
    "format": "bunx prettier --write .",
    "format:check": "bunx prettier --check .",
    "test": "bun test",
    "bench": "MTRL_BENCH=1 bun test test/benchmarks/",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:ui": "bun test --watch --ui",
    "docs": "typedoc --skipErrorChecking",
    "docs:js": "typedoc --options typedoc.simple.json",
    "docs:serve": "bun run --bun serve docs",
    "docs:fix-errors": "tsc --noEmit --allowJs --skipLibCheck",
    "ts:check": "tsc --noEmit --skipLibCheck",
    "ts:next-error": "bun scripts/next-ts-error.ts",
    "ts:fix": "bun scripts/fix-typescript.ts",
    "ts:fix-file": "bun scripts/fix-typescript.ts",
    "ts:fix-next": "bun scripts/fix-next-error.ts",
    "size:check": "bun run scripts/check-package-size.ts",
    "consumer:check": "bun run scripts/check-consumer.ts",
    "tooling:check": "tsc --project tsconfig.tools.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/floor/mtrl.git"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jsdom": "^21.1.7",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "eslint": "8",
    "jsdom": "^26.0.0",
    "playwright": "^1.63.0",
    "sass": "^1.85.1",
    "typedoc": "^0.27.9",
    "typescript": "^5.8.2",
    "vite": "^8.2.2"
  }
}
