    "@types/jsdom": "^21.1.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@vue/server-renderer": "^3.5",
    "babel-preset-solid": "^1.9",
    "eslint": "8",
    "jsdom": "^26.0.0",
    "linkedom": "^0.18.13",
    "playwright": "^1.63.0",
    "react": "^19",
    "react-18": "npm:react@^18.3.1",
    "react-dom": "^19",
    "react-dom-18": "npm:react-dom@^18.3.1",
    "sass": "^1.85.1",
    "solid-js": "^1.9",
    "svelte": "^5",
    "typedoc": "^0.27.9",
    "typescript": "^5.8.2",
