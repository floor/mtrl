{
  "name": "mtrl",
  "version": "0.10.7",
  "description": "Material Design 3 components for the web: plain JavaScript, web components, and React, Vue, Svelte and Solid components. TypeScript, zero dependencies.",
  "author": "floor",
  "license": "MIT",
  "keywords": [
    "material design 3",
    "material design",
    "material 3",
    "md3",
    "m3",
    "material you",
    "components",
    "ui",
    "web components",
    "custom elements",
    "typescript",
    "react",
    "vue",
    "svelte",
    "solid",
    "design system"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "**/styles/*.js",
    "**/elements/css/*.js"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.css"
    },
    "./components/text-field/constants": {
      "types": "./dist/components/textfield/constants.d.ts",
      "import": "./dist/components/textfield/constants.js"
    },
    "./components/text-field": {
      "types": "./dist/components/textfield/index.d.ts",
      "import": "./dist/components/textfield/index.js"
    },
    "./components/*/constants": {
      "types": "./dist/components/*/constants.d.ts",
      "import": "./dist/components/*/constants.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./elements": {
      "types": "./dist/elements/index.d.ts",
      "import": "./dist/elements/index.js"
    },
    "./elements/css": {
      "types": "./dist/elements/css/index.d.ts",
      "import": "./dist/elements/css/index.js"
    },
    "./elements/css/text-field": {
      "types": "./dist/elements/css/textfield.d.ts",
      "import": "./dist/elements/css/textfield.js"
    },
    "./elements/css/*": {
      "types": "./dist/elements/css/*.d.ts",
      "import": "./dist/elements/css/*.js"
    },
    "./elements/preupgrade.css": {
      "types": "./dist/elements/preupgrade.css.d.ts",
      "default": "./dist/elements/preupgrade.css"
    },
    "./elements/preupgrade": {
      "types": "./dist/elements/preupgrade.d.ts",
      "import": "./dist/elements/preupgrade.js"
    },
    "./react/jsx": {
      "types": "./dist/react/jsx.d.ts"
    },
    "./solid/jsx": {
      "types": "./dist/solid/jsx.d.ts"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "import": "./dist/solid/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "import": "./dist/svelte/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./core/*": {
      "types": "./dist/core/*/index.d.ts",
      "import": "./dist/core/*/index.js"
    },
    "./styles/text-field": {
      "types": "./dist/styles/textfield.d.ts",
      "import": "./dist/styles/textfield.js"
    },
    "./styles/*": {
      "types": "./dist/styles/*.d.ts",
      "import": "./dist/styles/*.js"
    },
    "./themes/*": "./dist/themes/*.css"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "prepublishOnly": "bun run build",
    "lint": "bunx eslint src scripts --ext .ts,.tsx",
    "lint:fix": "bunx eslint src scripts --ext .ts,.tsx --fix",
    "test": "bun test",
    "test:naming": "bun run scripts/check-test-naming.ts",
    "test:types": "bun run scripts/check-test-types.ts",
    "bench": "MTRL_BENCH=1 bun test test/benchmarks/",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "docs": "typedoc --skipErrorChecking",
    "ts:check": "tsc --noEmit --skipLibCheck",
    "size": "bun run scripts/size.ts",
    "size:check": "bun run scripts/check-package-size.ts",
    "adapters:size": "bun run scripts/check-adapter-size.ts",
    "tokens:check": "bun run scripts/check-token-render.ts",
    "root-exports:check": "bun run scripts/root-exports.ts",
    "component-exports:check": "bun run scripts/component-exports.ts",
    "component-exports:update": "bun run scripts/component-exports.ts --update",
    "root-exports:update": "bun run scripts/root-exports.ts --update",
    "classes:check": "bun run scripts/check-class-names.ts",
    "consumer:check": "bun run scripts/check-consumer.ts",
    "tabs:check": "bun run scripts/check-tabs.ts",
    "slider:check": "bun run scripts/check-slider.ts",
    "drawer:check": "bun run scripts/check-drawer.ts",
    "navigation-rail:check": "bun run scripts/check-navigation-rail.ts",
    "core:check": "bun run scripts/check-core.ts",
    "elements:check": "bun run scripts/check-elements.ts",
    "shadow-styles:check": "bun run scripts/check-shadow-styles.ts",
    "preupgrade:check": "bun run scripts/check-preupgrade.ts",
    "adapters:generate": "bun run scripts/generate-adapters.ts",
    "react:check": "bun run scripts/generate-adapters.ts --check && bun run scripts/check-react.ts",
    "vue:check": "bun run scripts/generate-adapters.ts --check && bun run scripts/check-vue.ts",
    "svelte:check": "bun run scripts/check-svelte.ts",
    "solid:check": "bun run scripts/generate-adapters.ts --check && bun run scripts/check-solid.ts",
    "tooling:check": "tsc --project scripts/tsconfig.json --noEmit && tsc --project test/types/tsconfig.json --noEmit",
    "themes:generate": "bun scripts/generate-themes.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/floor/mtrl.git"
  },
  "homepage": "https://md3.io",
  "bugs": {
    "url": "https://github.com/floor/mtrl/issues"
  },
  "peerDependencies": {
    "react": ">=18",
    "solid-js": ">=1.8",
    "svelte": ">=5",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7",
    "@babel/preset-typescript": "^7",
    "@material/material-color-utilities": "0.4.0",
    "@types/babel__core": "^7",
    "@types/bun": "latest",
    "@types/jsdom": "^21.1.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@vue/server-renderer": "^3.5",
    "babel-preset-solid": "^1.9",
    "eslint": "8",
    "jsdom": "^26.0.0",
    "playwright": "^1.63.0",
    "react": "^19",
    "react-18": "npm:react@^18.3.1",
    "react-dom": "^19",
    "react-dom-18": "npm:react-dom@^18.3.1",
    "sass": "^1.85.1",
    "solid-js": "^1.9",
    "svelte": "^5",
    "typedoc": "^0.27.9",
    "typescript": "^5.8.2",
    "vite": "^8.2.2",
    "vue": "^3.5"
  },
  "eslintConfig": {
    "root": true,
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module"
    },
    "env": {
      "node": true,
      "browser": true,
      "es2022": true
    },
    "rules": {
      "@typescript-eslint/no-unsafe-function-type": "off",
      "@typescript-eslint/ban-ts-comment": "warn",
      "prefer-const": "error",
      "no-var": "error",
      "no-console": "off",
      "no-case-declarations": "off",
      "@typescript-eslint/no-unused-expressions": "off",
      "@typescript-eslint/no-this-alias": "off",
      "prefer-rest-params": "off",
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "ignoreRestSiblings": true,
          "varsIgnorePattern": "^_",
          "argsIgnorePattern": "^_"
        }
      ]
    },
    "ignorePatterns": [
      "node_modules/",
      "dist/",
      "build/",
      "*.js",
      "test/**/*.ts",
      "**/*.test.ts",
      "**/*.spec.ts"
    ]
  },
  "typedocOptions": {
    "entryPoints": [
      "./src/index.ts"
    ],
    "out": "docs/api",
    "name": "mtrl Documentation",
    "exclude": [
      "**/node_modules/**",
      "**/*.test.ts",
      "**/*.spec.ts"
    ],
    "excludePrivate": false,
    "excludeExternals": true,
    "excludeInternal": true,
    "includeVersion": true,
    "hideGenerator": true,
    "searchInComments": true,
    "theme": "default",
    "categoryOrder": [
      "Core",
      "Components",
      "Utilities",
      "*"
    ],
    "categorizeByGroup": true,
    "readme": "README.md",
    "sort": [
      "static-first",
      "alphabetical"
    ],
    "navigationLinks": {
      "GitHub": "https://github.com/floor/mtrl"
    },
    "skipErrorChecking": true,
    "disableSources": false,
    "validation": {
      "invalidLink": true,
      "notDocumented": true
    },
    "visibilityFilters": {
      "protected": true,
      "private": false,
      "inherited": true,
      "external": false
    }
  }
}
