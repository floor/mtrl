{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "rootDir": "..",
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "declaration": false,
    "types": [
      "bun"
    ]
  },
  "include": [
    "./**/*.ts",
    "../test/build/style-manifest.test.ts",
    "../test/browser/fixture.ts"
  ],
  "exclude": [
    "../node_modules",
    "fixtures/peer-types"
  ]
}
