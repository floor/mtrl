{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "rootDir": ".",
    "moduleResolution": "bundler",
    "noEmit": true,
    "declaration": false,
    "types": [
      "bun"
    ]
  },
  "include": [
    "build.ts",
    "scripts/**/*.ts",
    "test/build/style-manifest.test.ts",
    "test/browser/fixture.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
